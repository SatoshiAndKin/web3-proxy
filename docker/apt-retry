#!/bin/sh
set -eu

# Fresh processes avoid the vulnerable in-process download retries in old APT.
# Five attempts wait 15, 30, 60, and 120 seconds. Never retry the release tests.
attempt=1
delay=15
while :; do
    if apt-get -o Acquire::Retries=0 -o APT::Update::Error-Mode=any "$@"; then
        exit 0
    else
        status=$?
    fi
    if [ "$attempt" -ge 5 ]; then
        echo "apt-get failed after $attempt attempts (exit $status)" >&2
        exit "$status"
    fi
    echo "apt-get attempt $attempt failed (exit $status); retrying in ${delay}s" >&2
    sleep "$delay"
    attempt=$((attempt + 1))
    delay=$((delay * 2))
done
